{
    "name": "web-e2e",
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "projectType": "application",
    "sourceRoot": "apps/web-e2e/src",
    "tags": ["scope:e2e", "domain:web", "type:e2e"],
    "implicitDependencies": [
        "web",
        "web-backend",
        "stalker-mock-server",
        "xtream-mock-server"
    ],
    "targets": {
        "test-service-worker": {
            "executor": "nx:run-commands",
            "inputs": [
                "default",
                "{workspaceRoot}/patches/@angular__service-worker@22.2.2.patch",
                "{workspaceRoot}/pnpm-lock.yaml"
            ],
            "options": {
                "command": "node --test apps/web-e2e/src/service-worker-update.test.mjs"
            }
        },
        "pwa-updates": {
            "executor": "nx:run-commands",
            "dependsOn": [
                {
                    "projects": ["web"],
                    "target": "build-pwa"
                }
            ],
            "cache": false,
            "options": {
                "cwd": "apps/web-e2e",
                "command": "playwright test --config=playwright.pwa-updates.config.ts"
            }
        },
        "e2e": {
            "dependsOn": []
        },
        "lint": {
            "inputs": [
                "default",
                "^default",
                "{workspaceRoot}/.eslintrc.json",
                "{workspaceRoot}/.eslintignore",
                "{workspaceRoot}/eslint.config.mjs",
                "{workspaceRoot}/tools/eslint-rules/**/*",
                "{workspaceRoot}/tools/eslint/**/*"
            ]
        }
    }
}
