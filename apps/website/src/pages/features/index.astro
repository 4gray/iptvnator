---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { FEATURES } from '../../lib/features';
import { absoluteUrl } from '../../lib/site';
import { REPO_URL } from '../../lib/downloads';

const pageUrl = absoluteUrl('/features/');
const title = 'IPTVnator Features – M3U, Xtream Codes, Stalker Portals, EPG and Remote';
const description =
  'What IPTVnator does: M3U and M3U8 playlists, Xtream Codes and Stalker portals, an XMLTV program guide with catch-up, a phone remote, offline downloads, TMDB metadata and MPV or VLC playback. Free and open source for Windows, macOS and Linux.';

const more = [
  { title: 'Offline downloads', text: 'Movies, episodes and whole seasons from Xtream and Stalker sources, with resume on interrupted transfers.' },
  { title: 'Movie and series metadata', text: 'Optional TMDB enrichment with posters, cast, ratings, trailers, actor pages and a Discover view.' },
  { title: 'MPV, VLC and embedded MPV', text: 'Hand streams to MPV or VLC, or render mpv inside the window with the experimental embedded engine.' },
  { title: 'Global collections', text: 'Favorites, recent items and search that span every source you added.' },
  { title: 'Dashboard', text: 'Continue watching, favorites rails, recently added content and source cards with expiry chips.' },
  { title: 'Privacy first', text: 'No account, no analytics. Playlists and credentials stay on your device.' },
  { title: 'Nineteen languages', text: 'Community-contributed translations, light and dark themes.' },
  { title: 'Self-hosted browser version', text: 'A Docker image serves the web app and its backend for devices that cannot run the desktop app.' },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'IPTVnator',
    applicationCategory: 'MultimediaApplication',
    applicationSubCategory: 'IPTV player',
    operatingSystem: 'Windows, macOS, Linux',
    url: pageUrl,
    downloadUrl: absoluteUrl('/download/'),
    featureList: FEATURES.map((feature) => feature.label),
    isAccessibleForFree: true,
    license: `${REPO_URL}/blob/master/LICENSE`,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    author: { '@type': 'Person', name: '4gray', url: 'https://github.com/4gray' },
    description,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'IPTVnator', item: absoluteUrl('/') },
      { '@type': 'ListItem', position: 2, name: 'Features', item: pageUrl },
    ],
  },
];
---

<BaseLayout
  title={title}
  description={description}
  keywords={['IPTVnator features', 'IPTV player features', 'M3U player', 'Xtream Codes player', 'Stalker portal player', 'IPTV EPG', 'open-source IPTV player']}
  jsonLd={jsonLd}
>
  <section class="relative overflow-hidden pt-36 pb-16 sm:pt-40">
    <div class="pointer-events-none absolute top-0 left-1/2 h-[520px] w-[900px] -translate-x-1/2 -translate-y-1/3 rounded-full bg-accent-500/[0.06] blur-[120px]"></div>

    <div class="relative mx-auto max-w-6xl px-6">
      <div class="mx-auto max-w-2xl text-center">
        <span class="font-mono text-xs uppercase tracking-[0.2em] text-accent-500">Features</span>
        <h1 class="mt-4 font-display text-4xl font-bold tracking-tight text-surface-50 sm:text-5xl lg:text-6xl">
          Everything <em class="font-medium text-accent-400" style="font-style: italic;">IPTVnator</em> does
        </h1>
        <p class="mt-6 text-lg leading-relaxed text-surface-400">
          One player for the three ways providers hand out access, with a program guide, a phone remote and the
          comforts of a desktop app. Each page below goes into detail and links to the matching setup guide.
        </p>
        <p class="mt-4 text-sm text-surface-500">
          Not sure which one you need?{' '}
          <a href="/iptvnator/compare/" class="text-accent-400 underline decoration-accent-500/30 underline-offset-4 transition-colors hover:text-accent-300">
            Compare your options
          </a>
        </p>
      </div>

      <div class="mt-14 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        {FEATURES.map((feature) => (
          <a href={feature.href} class="card-dotted group flex flex-col p-7">
            <span class="flex h-10 w-10 items-center justify-center rounded-lg bg-accent-500/[0.08] ring-1 ring-accent-500/20 transition-all duration-300 group-hover:bg-accent-500/[0.14] group-hover:ring-accent-500/35">
              <svg class="h-5 w-5 text-accent-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d={feature.icon} />
              </svg>
            </span>
            <h2 class="mt-5 font-display text-xl font-bold tracking-tight text-surface-50">{feature.label}</h2>
            <p class="mt-3 flex-1 text-sm leading-relaxed text-surface-400">{feature.summary}</p>
            <span class="mt-5 inline-flex items-center gap-1.5 font-mono text-xs uppercase tracking-[0.1em] text-accent-500 transition-colors group-hover:text-accent-400">
              Learn more
              <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </span>
          </a>
        ))}
        <a href="/iptvnator/download/" class="group flex flex-col justify-between rounded-lg border border-dashed border-accent-500/40 bg-accent-500/[0.06] p-7 transition-all duration-300 hover:bg-accent-500/[0.1]">
          <div>
            <span class="font-mono text-xs uppercase tracking-[0.2em] text-accent-500">Get started</span>
            <h2 class="mt-4 font-display text-xl font-bold tracking-tight text-surface-50">Download for Windows, macOS or Linux</h2>
            <p class="mt-3 text-sm leading-relaxed text-surface-400">Direct installers, Homebrew, Snap, AUR and a self-hosted browser version.</p>
          </div>
          <span class="mt-5 inline-flex items-center gap-1.5 font-mono text-xs uppercase tracking-[0.1em] text-accent-400">
            Download
            <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </span>
        </a>
      </div>
    </div>
  </section>

  <section class="relative py-20">
    <hr class="section-divider mb-20" />
    <div class="mx-auto max-w-6xl px-6">
      <div class="max-w-2xl">
        <span class="font-mono text-xs uppercase tracking-[0.2em] text-accent-500">And more</span>
        <h2 class="mt-4 font-display text-3xl font-bold tracking-tight text-surface-50 sm:text-4xl">
          The rest of the <em class="font-medium text-accent-400" style="font-style: italic;">desktop app</em>
        </h2>
      </div>
      <dl class="mt-12 grid gap-px overflow-hidden rounded-lg border border-dashed border-surface-600/60 bg-surface-700/40 sm:grid-cols-2">
        {more.map((item) => (
          <div class="bg-surface-950/95 px-5 py-4">
            <dt class="font-display text-base font-semibold text-surface-100">{item.title}</dt>
            <dd class="mt-1.5 text-sm leading-relaxed text-surface-400">{item.text}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>
</BaseLayout>
