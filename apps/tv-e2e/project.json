{
    "name": "tv-e2e",
    "projectType": "application",
    "sourceRoot": "apps/tv-e2e/src",
    "tags": ["scope:tv", "domain:tv", "type:e2e"],
    "implicitDependencies": [
        "tv",
        "xtream-mock-server",
        "stalker-mock-server",
        "web-backend"
    ],
    "targets": {
        "e2e": {
            "dependsOn": [
                {
                    "target": "build",
                    "projects": ["tv"]
                }
            ]
        },
        "lint": {
            "command": "eslint \"apps/tv-e2e/**/*.ts\""
        },
        "typecheck": {
            "command": "tsc -p apps/tv-e2e/tsconfig.spec.json --noEmit"
        }
    }
}
