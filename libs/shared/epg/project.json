{
    "name": "shared-epg",
    "$schema": "../../../node_modules/nx/schemas/project-schema.json",
    "sourceRoot": "libs/shared/epg/src",
    "projectType": "library",
    "tags": ["scope:shared", "domain:shared-contracts", "type:util"],
    "targets": {
        "test": {
            "executor": "nx:run-commands",
            "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
            "options": {
                "command": "node ./tools/testing/run-web-esm-lib-tests.mjs libs/shared/epg/src",
                "env": { "NODE_OPTIONS": "--experimental-vm-modules" },
                "forwardAllArgs": true
            }
        },
        "lint": {
            "command": "eslint \"libs/shared/epg/**/*.ts\""
        }
    }
}
