{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "emitDecoratorMetadata": false,
        "outDir": "../../../dist/out-tsc",
        "module": "commonjs",
        "target": "es2016",
        "types": ["jest", "node"],
        "moduleResolution": "node10"
    },
    "files": ["src/test-setup.ts"],
    "include": [
        "jest.config.ts",
        "src/**/*.test.ts",
        "src/**/*.spec.ts",
        "src/**/*.d.ts"
