<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="phone_settings_background">#17191f</color>
    <color name="phone_settings_surface">#22262e</color>
    <color name="phone_settings_control">#2d3644</color>
    <color name="phone_settings_outline">#465266</color>
    <color name="phone_settings_control_outline">#65748b</color>
    <color name="phone_settings_text">#f5f5f7</color>
    <color name="phone_settings_muted">#b6c0cf</color>
    <color name="phone_settings_accent">#7cc4ff</color>
    <color name="phone_settings_on_accent">#102238</color>
    <color name="phone_settings_danger">#ffb5bd</color>

    <style name="PhoneSettingsCard">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">16dp</item>
        <item name="android:background">@drawable/phone_settings_card</item>
    </style>

    <style name="PhoneSettingsText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/phone_settings_text</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="PhoneSettingsText.Section">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">18sp</item>
    </style>

    <style name="PhoneSettingsText.Label">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="PhoneSettingsText.Hint">
        <item name="android:textColor">@color/phone_settings_muted</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="PhoneSettingsField" parent="android:Widget.Material.EditText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:background">@drawable/phone_settings_field</item>
        <item name="android:inputType">textUri</item>
        <item name="android:singleLine">true</item>
        <item name="android:textColor">@color/phone_settings_text</item>
        <item name="android:textColorHint">@color/phone_settings_muted</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="PhoneSettingsButton" parent="android:Widget.Material.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:background">@drawable/phone_settings_secondary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">@color/phone_settings_button_text</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="PhoneSettingsButton.Primary">
        <item name="android:background">@drawable/phone_settings_primary</item>
        <item name="android:textColor">@color/phone_settings_on_accent</item>
    </style>

    <style name="PhoneSettingsButton.Row">
        <item name="android:background">?android:attr/selectableItemBackground</item>
        <item name="android:gravity">start|center_vertical</item>
        <item name="android:paddingStart">0dp</item>
        <item name="android:paddingEnd">0dp</item>
        <item name="android:textColor">@color/phone_settings_accent</item>
    </style>

    <style name="PhoneSettingsButton.Disclosure" parent="PhoneSettingsButton.Row">
        <item name="android:drawableEnd">@drawable/phone_settings_disclosure</item>
        <item name="android:drawablePadding">12dp</item>
        <item name="android:textColor">@color/phone_settings_text</item>
    </style>

    <style name="PhoneSettingsButton.Danger" parent="PhoneSettingsButton.Row">
        <item name="android:textColor">@color/phone_settings_danger</item>
    </style>

    <style name="PhoneSettingsChoice" parent="SettingsRadio">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_marginEnd">0dp</item>
        <item name="android:textColor">@color/phone_settings_text</item>
    </style>
</resources>
