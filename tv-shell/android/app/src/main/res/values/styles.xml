<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark, full-screen, no action bar: a TV app. Built-in Material theme, no AndroidX. -->
    <style name="Theme.TvShell" parent="android:Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:colorPrimary">#2f6fed</item>
        <item name="android:colorAccent">#7cc4ff</item>
        <item name="android:colorControlActivated">#7cc4ff</item>
        <item name="android:colorControlHighlight">#337cc4ff</item>
        <item name="android:textColorPrimary">#f5f5f7</item>
        <item name="android:textColorSecondary">#b0b0b8</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <style name="SettingsSection">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">28dp</item>
        <item name="android:textColor">#7cc4ff</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="SettingsHint">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:textColor">#b0b0b8</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="SettingsRadio">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginEnd">24dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:textColor">#f5f5f7</item>
        <item name="android:textSize">16sp</item>
    </style>
</resources>
