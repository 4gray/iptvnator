<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/settings_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1f1f23"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/settings_content"
        android:orientation="vertical"
        android:padding="40dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_title"
            android:textColor="#f5f5f7"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView style="@style/SettingsSection" android:text="@string/connection_title" />
        <TextView style="@style/SettingsHint" android:text="@string/connection_hint" />
        <EditText android:id="@+id/host_address" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:singleLine="true"
            android:inputType="textUri" android:hint="https://server.example" />
        <TextView style="@style/SettingsHint" android:text="@string/approval_address_hint" />
        <EditText android:id="@+id/approval_address" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:singleLine="true"
            android:inputType="textUri" android:hint="https://server.example" />
        <Button android:id="@+id/pair_host" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="@string/pair_host" />
        <Button android:id="@+id/connect_host" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="@string/connect_host" />
        <Button android:id="@+id/local_library" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="@string/local_library" />
        <Button android:id="@+id/scan_tv" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="@string/scan_tv" />
        <TextView android:id="@+id/connection_status" style="@style/SettingsHint" />

        <TextView
            style="@style/SettingsSection"
            android:text="@string/setting_layout_mode" />

        <RadioGroup
            android:id="@+id/layout_mode_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/layout_auto"
                style="@style/SettingsRadio"
                android:text="@string/layout_auto" />

            <RadioButton
                android:id="@+id/layout_touch"
                style="@style/SettingsRadio"
                android:text="@string/layout_touch" />

            <RadioButton
                android:id="@+id/layout_tv"
                style="@style/SettingsRadio"
                android:text="@string/layout_tv" />
        </RadioGroup>

        <TextView
            android:id="@+id/width_heading"
            style="@style/SettingsSection"
            android:text="@string/setting_width" />

        <TextView
            android:id="@+id/width_hint"
            style="@style/SettingsHint"
            android:text="@string/setting_width_hint" />

        <RadioGroup
            android:id="@+id/width_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/width_960"
                style="@style/SettingsRadio"
                android:text="@string/width_960" />

            <RadioButton
                android:id="@+id/width_1280"
                style="@style/SettingsRadio"
                android:text="@string/width_1280" />

            <RadioButton
                android:id="@+id/width_1600"
                style="@style/SettingsRadio"
                android:text="@string/width_1600" />
        </RadioGroup>

        <TextView
            style="@style/SettingsSection"
            android:text="@string/setting_external" />

        <CheckBox
            android:id="@+id/prompt_external"
            style="@style/SettingsRadio"
            android:text="@string/setting_prompt_external" />

        <TextView
            style="@style/SettingsHint"
            android:text="@string/setting_player_hint" />

        <RadioGroup
            android:id="@+id/player_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/player_hint"
            style="@style/SettingsHint"
            android:text="@string/no_external_player"
            android:visibility="gone" />

        <TextView
            style="@style/SettingsSection"
            android:text="@string/setting_advanced" />

        <CheckBox
            android:id="@+id/web_debug"
            style="@style/SettingsRadio"
            android:text="@string/setting_web_debug" />

        <Button
            android:id="@+id/reset_data"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/reset_title" />

        <TextView
            style="@style/SettingsSection"
            android:text="@string/setting_diagnostics" />

        <TextView
            android:id="@+id/diagnostics"
            style="@style/SettingsHint"
            android:textIsSelectable="false" />

        <Button
            android:id="@+id/done"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:minWidth="200dp"
            android:text="@string/done" />
    </LinearLayout>
</ScrollView>
